# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3099
AUTH_SECRET=run-openssl-rand-base64-32

# ─── App URL (used for share links in Quick Debate pages) ────────────
NEXT_PUBLIC_APP_URL=http://localhost:3099

# ─── OAuth providers ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Admin allow-list ────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com
ADMIN_USER_ID=

# ─── AI Lab ──────────────────────────────────────────────────────────
AI_LAB_ENABLED=true
AI_LAB_ROOM_ID=
AI_LAB_ARCHIVE_INDEXABLE=false
AI_MENTION_DAILY_LIMIT=10

# ─── Quota partitioning ──────────────────────────────────────────────
# Actual daily token limit from your Groq dashboard. Groq free-plan GPT-OSS TPD is 200,000.
GROQ_DAILY_TPD_LIMIT=200000

# ─── Removed feature ──────────────────────────────────────────────────
# Quick Debate was permanently removed; this variable is retained only for old deployments.
QUICK_DEBATE_DAILY_CAP=150

# ─── AI provider keys ────────────────────────────────────────────────
GROQ_API_KEY=
GITHUB_TOKEN=
# CEREBRAS_API_KEY removed — all Cerebras agents migrated to Groq/GitHub Models (2026-05-13)

# ─── AI model overrides (optional — defaults set in personas.ts) ─────
# Override any model without redeploying. Defaults shown below.
# qwen/qwen3-32b deprecated by Groq 2026-07-17 — ADMIN/LLAMA/FALLBACK migrated
# 2026-07-16. All agents migrated to Groq 2026-08-07 (GitHub Models retired).
AGENT_MODEL_ADMIN=       # default: openai/gpt-oss-120b  (Groq — verified live 2026-07-16)
AGENT_MODEL_LLAMA=       # default: openai/gpt-oss-120b  (Groq — verified live 2026-07-16)
AGENT_MODEL_GPTOSS=      # default: openai/gpt-oss-120b  (Groq — VERIFY: non-standard naming, confirm at console.groq.com/docs/models)
AGENT_MODEL_QWEN=        # default: llama-3.3-70b-versatile  (Groq — verified live 2026-08-07)
AGENT_MODEL_ARCHIVIST=   # default: openai/gpt-oss-120b  (Groq — verified live 2026-08-07)
AGENT_MODEL_FALLBACK=    # default: openai/gpt-oss-20b  (Groq — verified live 2026-07-16)

# ─── Research Layer ─────────────────────────────────────────────────
CURRENTS_API_KEY=              # currentsapi.services — 1,000 req/day free, no card
NEWSDATA_API_KEY=              # newsdata.io — 200 req/day free, commercial OK

# ─── Cron auth ───────────────────────────────────────────────────────
CRON_SECRET=run-openssl-rand-hex-32
